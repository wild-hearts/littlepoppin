{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/printclub-send",
      "schedule": "0 21 1 * *"
    },
    {
      "path": "/api/review-request",
      "schedule": "0 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/c/:slug",
      "destination": "/open.html"
    },
    {
      "source": "/i/:slug",
      "destination": "/invite.html"
    },
    {
      "source": "/manage/:id",
      "destination": "/manage.html"
    },
    {
      "source": "/sent/:key",
      "destination": "/sent.html"
    },
    {
      "source": "/host/:key",
      "destination": "/api/keepsakes?op=host&key=:key"
    }
  ]
}
