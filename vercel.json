{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/printclub-send",
      "schedule": "0 21 1 * *"
    },
    {
      "path": "/api/review-request",
      "schedule": "0 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/i/:code",
      "destination": "/api/invite-page?code=:code"
    },
    {
      "source": "/invite-preview",
      "destination": "/api/invite-page?preview=1"
    }
  ]
}
