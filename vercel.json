{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/printclub-send",
      "schedule": "0 21 1 * *"
    },
    {
      "path": "/api/review-request",
      "schedule": "0 23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
